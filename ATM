    if (account == NULL) {
        cout << "Account not found." << endl;
        return;
    }
    cout << "Enter PIN: ";
    pin = inp_PIN();
    pin = encrypt_PIN(pin);

    if (pin != account->data.pinCode) {
        cout << "Incorrect PIN." << endl;
        return;
    }
    int choice;
    do {
    	system("cls");
        cout << "=========== TRANSACTION MENU ===========" << endl;
