void currentBalance(Node* account) {
    cout << fixed << setprecision(2);
    cout << "Current Balance: " << account->data.initial_deposit << endl;
}

void withdraw(Node* account) {
    double amount = enter_Amount();
    if (amount > account->data.initial_deposit){
        cout << "Insufficient balance in your account." << endl;
        return;
    }
    account->data.initial_deposit -=amount;
    cout << "Withdrawal successful." << endl;
}

void deposit (Node* account) {
    double amount = enter_Amount();
    account->data.initial_deposit += amount;
    cout << "Deposit successful." << endl;
}

void fund_Transfer(Node* sender, Registration_list& reg) {
    string recipientNumber;
    cout << "Send to:" << endl;
    cout << "Enter account number: ";
    cin >> recipientNumber;
    Node* recipient = reg.find_Account(recipientNumber);

    if (recipient == NULL) {
        cout << "Recipient account does not exist." << endl;
        return;
    }
    if (recipient == sender) {
        cout << "You are transferring money into your own account. Transaction cancelled." << endl;
    }
    double amount = enter_Amount();
    if(amount > sender->data.initial_deposit) {
        cout << "Insufficient balance in your account." << endl;
        return;
    }
    sender->data.initial_deposit -= amount;
    recipient->data.initial_deposit += amount;
    cout << "Transfer from " << sender->data.account_number << " to " 
    << recipient->data.account_number << " successful." << endl;
}

void changePIN (Node* account) {
    string current_PIN;
    string new_PIN;

    cout << "Enter your current PIN: ";
    cin >> current_PIN;

    if (current_PIN != account->data.pinCode){
        cout << "PIN does not match the account number." << endl;
        return;
    }
    cout << "Enter new PIN: ";
    cin >> new_PIN;
    account->data.pinCode = new_PIN;
    cout << "PIN changed successfully." << endl;
}

void transaction(Registration_list& reg) {
    string accountNumber;
